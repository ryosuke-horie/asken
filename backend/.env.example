# Firebase/Firestore認証（必須）
# GCPサービスアカウントキーのパス
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Gemini API設定（必須）
GEMINI_API_KEY=your-gemini-api-key

# Cloud Storage設定（必須）
# 画像アップロード用バケット名
GCS_BUCKET_NAME=your-bucket-name

# CORS設定（オプション）
# カンマ区切りで複数指定可能
ALLOWED_ORIGINS=http://localhost:3000

# 開発環境設定（オプション）
# developmentに設定するとモック認証が有効になる
# 本番環境では設定しないこと
APP_ENV=development
