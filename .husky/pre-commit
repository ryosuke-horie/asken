#!/bin/sh
set -e

# iOS: SwiftLint & SwiftFormat
STAGED_IOS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^ios/.*\.swift$' || true)

if [ -n "$STAGED_IOS" ]; then
  echo "[iOS] Running SwiftLint..."
  if command -v swiftlint >/dev/null 2>&1; then
    cd ios
    swiftlint lint --strict
    cd ..
  else
    echo "[iOS] SwiftLint not found, skipping..."
  fi

  echo "[iOS] Running SwiftFormat..."
  if command -v swiftformat >/dev/null 2>&1; then
    cd ios
    swiftformat . --lint
    cd ..
  else
    echo "[iOS] SwiftFormat not found, skipping..."
  fi
fi

# Backend: golangci-lint
STAGED_BACKEND=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^backend/.*\.go$' || true)

if [ -n "$STAGED_BACKEND" ]; then
  echo "[Backend] Running golangci-lint..."
  cd backend
  golangci-lint run ./...
  cd ..
fi

if [ -n "$STAGED_IOS" ] || [ -n "$STAGED_BACKEND" ]; then
  echo "[OK] Pre-commit checks passed!"
fi
