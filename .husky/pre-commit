#!/bin/sh
set -e

# Frontend: lint-staged (ESLint, Prettier, TypeScript)
cd frontend

# ステージされたフロントエンドファイルがあるか確認
STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^frontend/' || true)

if [ -n "$STAGED_FRONTEND" ]; then
  echo "[Frontend] Running lint-staged..."
  npx lint-staged

  echo "[Frontend] Running TypeScript type check..."
  npm run typecheck
fi

cd ..

# Backend: golangci-lint
STAGED_BACKEND=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^backend/.*\.go$' || true)

if [ -n "$STAGED_BACKEND" ]; then
  echo "[Backend] Running golangci-lint..."
  cd backend
  golangci-lint run ./...
  cd ..
fi

if [ -n "$STAGED_FRONTEND" ] || [ -n "$STAGED_BACKEND" ]; then
  echo "[OK] Pre-commit checks passed!"
fi
